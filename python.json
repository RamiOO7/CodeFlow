[{"n":"Primeros pasos","ls":[{"n":"Hola mundo","i":"👋","t":"print() muestra texto en pantalla. El texto va entre comillas.","q":["Función para mostrar texto|echo()|print()|show()|1","¿Texto válido?|\"Hola\"|Hola|<Hola>|0"]},{"n":"Práctica: print","i":"⌨️","t":"Un programa son instrucciones, una por línea.","q":["¿Qué hace print(5)?|Muestra 5|Error|Nada|0"],"p":{"t":"Muestra un saludo con print.","r":"print\\s*\\(","h":"print(\"Hola\")"}},{"n":"Variables","i":"📦","t":"x = 5 guarda un valor en una variable.","q":["x = 7. ¿Qué guarda x?|El 7|El texto x|Nada|0","¿Cuál es válido?|nombre = \"Ana\"|1nombre = Ana|var nombre|0"]}]},{"n":"Control y funciones","ls":[{"n":"Práctica: if","i":"🔀","t":"if x > 3: ejecuta el bloque indentado si es cierto.","q":["¿Qué abre un condicional?|if|when|case|0"],"p":{"t":"Escribe un if con x > 3.","r":"if\\s+.+:","h":"if x > 3:\n    print(\"mayor\")"}},{"n":"Bucles","i":"🔁","t":"for i in range(3): repite 3 veces.","q":["¿Cuántas veces: range(3)?|3|2|4|0","¿Qué es un bucle?|Repetir código|Una variable|Un error|0"]},{"n":"Práctica: funciones","i":"🧩","t":"def saluda(): define una función; se llama con saluda().","q":["¿Qué define una función?|def|func|fn|0"],"p":{"t":"Define una función.","r":"def\\s+\\w+\\s*\\(.*\\)\\s*:","h":"def saluda():\n    print(\"Hola\")"}}]}]